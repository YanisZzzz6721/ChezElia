# Supabase — projet local (npx supabase start affiche ces valeurs) ou projet cloud.
# La clé « anon/publishable » est publique par conception ; elle ne donne aucun droit d'écriture (RLS).
# NE JAMAIS mettre ici la clé service_role : elle n'est utilisée que par scripts/create-admin.mjs, depuis le terminal.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SEO — le site reste NON indexable (robots.txt « tout interdit », noindex) tant que ces conditions ne sont pas toutes réunies :
#   1. NEXT_PUBLIC_SITE_URL = adresse https de production (ex. https://chez-elia.fr)
#   2. SITE_INDEXING = on (exactement)
#   3. toutes les mentions légales renseignées dans src/content/legal.ts
NEXT_PUBLIC_SITE_URL=
SITE_INDEXING=
